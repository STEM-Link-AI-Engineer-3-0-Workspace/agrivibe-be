# Copy this file to .env and fill in the two keys and the database URL.
OPENAI_API_KEY=
PINECONE_API_KEY=

# Postgres: a free Neon project (https://neon.tech) is enough. Use the direct connection string,
# not the pooled one (no -pooler in the host). Threads and farmer memory are kept here.
DATABASE_URL=

# The farmer this app acts for. The server decides who is asking; clients never send it.
# Keep FARMER_ID the same in agrivibe-fe's .env, which shows it on the page.
FARMER_ID=frm_7f3a9c2e
FARMER_NAME=Nimal Perera

# Optional. These are the defaults.
# CHAT_MODEL=openai:gpt-5.6-luna
# EMBEDDING_MODEL=text-embedding-3-small
# PINECONE_INDEX=fieldoracle
# FIELDSAT_URL=http://127.0.0.1:8001/mcp
# CORS_ORIGINS=["http://localhost:3000"]

# Two-stage retrieval. RERANKER is pinecone or none.
# RERANKER=pinecone
# RERANK_MODEL=bge-reranker-v2-m3
# RERANK_CANDIDATES=20
# SEARCH_K=4

# Optional. Langfuse tracing: set both keys to send every run to Langfuse.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
